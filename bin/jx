#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

# Prefer the locally-built dogfood escript (./jx) by default.
# This is the recommended path after running `MIX_ENV=prod mix escript.build`.
#
# To force running against the live source tree (useful during active development):
#   JX_USE_MIX=1 bin/jx ...
FORCE_MIX="${JX_USE_MIX:-0}"

if [ "$FORCE_MIX" != "1" ] && [ -x "$ROOT/jx" ]; then
  exec "$ROOT/jx" "$@"
fi

# Legacy support: JX_USE_ESCRIPT=1 still works
USE_ESCRIPT="${JX_USE_ESCRIPT:-0}"
if [ "$USE_ESCRIPT" = "1" ] && [ -x "$ROOT/jx" ]; then
  exec "$ROOT/jx" "$@"
fi

MIX_ENV="${MIX_ENV:-dev}"
CLI_BEAM="$ROOT/_build/$MIX_ENV/lib/jx/ebin/Elixir.JX.CLI.beam"
AUTO_COMPILE="${JX_AUTO_COMPILE:-0}"

if [ "$AUTO_COMPILE" = "1" ] || [ ! -f "$CLI_BEAM" ]; then
  mix compile --quiet >/dev/null
fi

exec mix run --no-compile --no-start -e 'JX.CLI.main(System.argv())' -- "$@"
